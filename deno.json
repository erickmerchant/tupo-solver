{
  "tasks": {
    "dev": "deno run -A --watch-hmr flint.ts --port=4000",
    "build": "deno run -A flint.ts --build",
    "stage": {
      "command": "deno serve -A --port=4000 --parallel dist/serve.ts",
      "dependencies": ["build"]
    }
  },
  "imports": {
    "@erickmerchant/fonts": "jsr:@erickmerchant/fonts@^0.7.5",
    "@flint/framework": "jsr:@flint/framework@^0.40.1",
    "@handcraft/lib": "jsr:@handcraft/lib@^4.7.1"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.window",
      "deno.unstable",
      "dom",
      "dom.iterable",
      "deno.worker",
      "es2025"
    ]
  },
  "unstable": ["bundle"]
}
